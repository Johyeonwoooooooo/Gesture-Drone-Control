  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo>\r\n  <plugin name=\"TelloPlugin\" filename=\"libTelloPlugin.so\">\r\n   
    <namespace>tello</namespace>\r\n    <parameter name=\"use_sim_time\" type=\"bool\">1</parameter>\r\n   
    <link_name>base_link</link_name>\r\n    <center_of_mass>0 0 0</center_of_mass>\r\n 
    </plugin>\r\n</gazebo>"
